/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; object-src 'none'; script-src 'self' 'unsafe-inline' 'sha256-OstaIcKfPNauneIZheIMMyfZx3Y2g5EJ9et9ImS7ClI='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; base-uri 'self'; form-action 'none'; upgrade-insecure-requests; frame-ancestors 'none'
