{
	"name": "sagnik-behera-portfolio",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "node -e \"const fs=require('fs'); fs.mkdirSync('build', {recursive:true}); fs.copyFileSync('index.html', 'build/index.html'); if(fs.existsSync('assets')) fs.cpSync('assets', 'build/assets', {recursive:true}); console.log('Static site ready');\"",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.57.3",
		"svelte-check": "4.6.0",
		"typescript": "7.0.2",
		"vite": "8.3.6"
	},
	"dependencies": {
		"isomorphic-dompurify": "^3.19.0"
	}
}
