# Environment Variables Configuration (.env.example)
# NOTE: This portfolio is an entirely static, pre-rendered website.
# No secrets, API keys, private tokens, or backend credentials are required or used.
# If you ever add third-party integrations (e.g. analytics or newsletter),
# define them here with placeholders and NEVER commit actual secrets to version control.

# Canonical public site URL (used in SEO meta and OpenGraph tags)
PUBLIC_SITE_URL=https://sagnikbehera.pages.dev

# Public contact recipient (built dynamically client-side in data.ts)
PUBLIC_CONTACT_EMAIL=sagnikbehera30@gmail.com

